# Everything here is optional. With no .env at all the app runs on an
# in-memory store with the checked-in catalog, which is enough to click
# through the entire flow locally.

# Public base URL. Used for share links, OG tags and .ics files.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Postgres. When unset, outing state is kept in memory and lost on restart.
# Neon or Supabase connection string, e.g.
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL=""

# Mapbox static images token. When unset, plan cards render a route list
# instead of a map image.
MAPBOX_TOKEN=""

# Shared secret for /admin. When unset, admin is open in development and
# blocked in production.
ADMIN_TOKEN=""

# PostHog. When unset, analytics calls become no-ops.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
